{
  "name": "@patimweb/pi-azure-devops",
  "version": "2.2.2",
  "description": "Azure DevOps integration for pi coding agent — work items, boards, repos, pull requests, pipelines, and test plans",
  "keywords": [
    "pi-package",
    "azure-devops",
    "ado",
    "pi-extension"
  ],
  "author": "Patrick Weppelmann",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/patimweb-agents/pi-azure-devops.git"
  },
  "bugs": {
    "url": "https://github.com/patimweb-agents/pi-azure-devops/issues"
  },
  "scripts": {
    "build": "echo 'No build step defined'",
    "test": "node --experimental-test-module-mocks --experimental-test-coverage --test 'test/**/*.test.ts'",
    "test:watch": "node --experimental-test-module-mocks --test --watch 'test/**/*.test.ts'"
  },
  "dependencies": {
    "azure-devops-node-api": "^17.0.1"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "^1.5.2",
    "@earendil-works/pi-tui": "^1.5.2",
    "@semantic-release/git": "^11.0.1",
    "semantic-release": "^25.0.9",
    "typebox": "^1.3.27"
  },
  "overrides": {
    "undici": "7.28.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ],
    "skills": [
      "./skills"
    ],
    "prompts": [
      "./prompts"
    ],
    "image": "https://raw.githubusercontent.com/Smotherer007/pi-azure-devops/main/screenshot.png"
  }
}
